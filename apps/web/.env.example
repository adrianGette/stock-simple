# Solo hace falta si la API NO se sirve por el mismo origen (en desarrollo se usa el proxy de Vite
# y en producción el de Netlify, así que normalmente queda vacío).
# VITE_API_URL=https://mi-api.example.com/api

# Mostrar los accesos rápidos con usuarios de demostración en el login (true por defecto).
VITE_SHOW_DEMO_USERS=true
