# Copiá este archivo a .env (valores para desarrollo local con docker compose)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://stock:stock@localhost:5433/stock_simple
# Orígenes permitidos para CORS, separados por coma
WEB_ORIGIN=http://localhost:5173
# Generá un secreto propio en producción: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# 'lax' si la web llega por el proxy del mismo origen (recomendado); 'none' si no hay proxy
COOKIE_SAME_SITE=lax
# Proxies delante de la API: 1 en local/Render directo, 2 con el proxy de Netlify
TRUST_PROXY_HOPS=1
# Demo pública con cuentas compartidas: bloquea crear o modificar usuarios
DEMO_MODE=false
