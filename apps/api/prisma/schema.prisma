// Modelo de datos de Stock Simple.
// Convenciones: dinero en centavos (Int), ids UUID, todas las tablas de negocio
// llevan businessId para aislar los datos de cada comercio (multi-tenant).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  SALE_VOID
  LOSS
  COUNT
}

enum PaymentMethod {
  CASH
  DEBIT
  CREDIT
  TRANSFER
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PriceChangeReason {
  MANUAL
  BULK
  PURCHASE
}

model Business {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  timezone    String   @default("America/Argentina/Buenos_Aires")
  /// Último número de venta emitido; se incrementa dentro de la transacción de venta.
  saleCounter Int      @default(0) @map("sale_counter")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users          User[]
  categories     Category[]
  products       Product[]
  sales          Sale[]
  stockMovements StockMovement[]
  priceChanges   PriceChange[]

  @@map("businesses")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions       Session[]
  sales          Sale[]          @relation("SaleSeller")
  voidedSales    Sale[]          @relation("SaleVoider")
  stockMovements StockMovement[]
  priceChanges   PriceChange[]

  @@index([businessId])
  @@map("users")
}

/// Sesión de refresh token. Se guarda solo el hash; el token viaja en una cookie httpOnly.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Si un token ya rotado se vuelve a usar, se revoca toda la familia (posible robo).
  familyId  String    @map("family_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  sku        String
  barcode    String?
  name       String
  costCents  Int      @map("cost_cents")
  priceCents Int      @map("price_cents")
  /// Stock actual. Es un caché del libro de movimientos y se actualiza en la misma transacción.
  stock      Int      @default(0)
  minStock   Int      @default(0) @map("min_stock")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  stockMovements StockMovement[]
  priceChanges   PriceChange[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, categoryId])
  @@index([businessId, name])
  @@map("products")
}

model StockMovement {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @map("business_id") @db.Uuid
  productId  String            @map("product_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  saleId     String?           @map("sale_id") @db.Uuid
  type       StockMovementType
  /// Diferencia con signo.
  quantity   Int
  stockAfter Int               @map("stock_after")
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  number         Int
  userId         String        @map("user_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key") @db.Uuid
  paymentMethod  PaymentMethod @map("payment_method")
  status         SaleStatus    @default(COMPLETED)
  totalCents     Int           @map("total_cents")
  /// Costo de la mercadería vendida al momento de la venta (para calcular ganancia).
  costCents      Int           @map("cost_cents")
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById     String?       @map("voided_by_id") @db.Uuid
  voidReason     String?       @map("void_reason")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user           User            @relation("SaleSeller", fields: [userId], references: [id])
  voidedBy       User?           @relation("SaleVoider", fields: [voidedById], references: [id])
  items          SaleItem[]
  stockMovements StockMovement[]

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@map("sales")
}

/// Línea de venta. Guarda nombre, precio y costo del momento: si mañana cambia el precio, la venta no cambia.
model SaleItem {
  id             String @id @default(uuid()) @db.Uuid
  saleId         String @map("sale_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  productName    String @map("product_name")
  sku            String
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  unitCostCents  Int    @map("unit_cost_cents")
  subtotalCents  Int    @map("subtotal_cents")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model PriceChange {
  id            String            @id @default(uuid()) @db.Uuid
  businessId    String            @map("business_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  /// Agrupa los cambios de una misma actualización masiva.
  batchId       String?           @map("batch_id") @db.Uuid
  reason        PriceChangeReason
  oldPriceCents Int               @map("old_price_cents")
  newPriceCents Int               @map("new_price_cents")
  oldCostCents  Int               @map("old_cost_cents")
  newCostCents  Int               @map("new_cost_cents")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@map("price_changes")
}
